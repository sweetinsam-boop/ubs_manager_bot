# 이 파일을 .env 로 복사해 값을 채우세요. 더 쉬운 방법: python3 setup_wizard.py
# .env 에는 계좌 키가 들어 있으므로 절대 공유하거나 깃에 올리지 마세요.

# 텔레그램: @BotFather 로 만든 봇 토큰
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz
# 봇을 쓸 채팅 ID (@userinfobot 에게 물어보면 알려줍니다). 비워 두면 처음 /start 한 채팅이 주인이 됩니다.
TELEGRAM_CHAT_ID=123456789

# 한국투자증권 개발자센터에서 발급한 실전투자용 키
APP_KEY=
APP_SECRET=
# 계좌번호 12345678-01 → CANO=12345678, ACNT_PRDT_CD=01
CANO=
ACNT_PRDT_CD=01
